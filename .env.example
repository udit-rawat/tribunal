# --- LLM provider (any OpenAI-compatible endpoint) ---
# Option A — OpenRouter:  https://openrouter.ai/keys
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   STRONG_MODEL=google/gemini-2.0-flash-exp:free
#   FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Option B — Google AI Studio (Gemini):  https://aistudio.google.com/apikey
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   STRONG_MODEL=gemini-2.5-flash
#   FAST_MODEL=gemini-2.5-flash-lite
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Per-agent models. STRONG = reasoning-heavy (Decomposer, Judge). FAST = cheaper (Retriever, Analyst).
STRONG_MODEL=google/gemini-2.0-flash-exp:free
FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Embeddings (local, free, runs on M1) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval tuning ---
TOP_K=5
MAX_SOURCES_PER_QUERY=4

# --- Langfuse observability (optional; leave blank to disable tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Human-in-the-loop (optional; CLI --review also enables it) ---
HITL_ENABLED=false
HITL_MIN_EVIDENCE=2

# --- Misc ---
LANCEDB_PATH=.lancedb
REQUEST_TIMEOUT=60
